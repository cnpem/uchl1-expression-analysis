{
  "_comment": "What the setup prepares. Analysis skills are the ones the researcher uses; each lists the dependency skills it needs. Edit here (not in setup.py) when a skill gains or loses a dependency.",
  "analysis_skills": {
    "expression-analysis": {
      "repo": "cnpem/uchl1-expression-analysis",
      "private": true,
      "check": [
        "scripts/expression.py",
        "check"
      ],
      "reference": "uchl1",
      "reproduce": [
        "scripts/expression.py",
        "reproduce",
        "--reference",
        "uchl1"
      ],
      "dependencies": [
        "uv",
        "credentials",
        "alphagenome-variant-impact-score",
        "alphagenome-single-variant-analysis",
        "alphagenome-atlas-website-links",
        "embl-ebi-ols",
        "ensembl-database",
        "alphagenome"
      ],
      "keys": {
        "required": [
          "ALPHAGENOME_API_KEY"
        ],
        "optional": []
      }
    },
    "splicing-analysis": {
      "repo": "cnpem/plp1-splicing-analysis",
      "private": true,
      "check": [
        "scripts/splicing.py",
        "check"
      ],
      "reference": "plp1",
      "reproduce": [
        "scripts/splicing.py",
        "reproduce",
        "--reference",
        "plp1"
      ],
      "dependencies": [
        "uv",
        "credentials",
        "alphagenome-variant-impact-score",
        "alphagenome-single-variant-analysis",
        "alphagenome-atlas-website-links",
        "clinvar-database",
        "gnomad-database",
        "dbsnp-database",
        "ensembl-database",
        "alphagenome"
      ],
      "keys": {
        "required": [
          "ALPHAGENOME_API_KEY"
        ],
        "optional": [
          "NCBI_API_KEY"
        ]
      }
    }
  },

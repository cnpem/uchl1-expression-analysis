{
  "_comment": "What the setup prepares. Analysis skills are the ones the researcher uses; each lists the dependency skills it needs. Edit here (not in setup.py) when a skill gains or loses a dependency.",
  "analysis_skills": {
    "expression-analysis": {
      "repo": "cnpem/uchl1-expression-analysis",
      "private": true,
      "check": ["scripts/expression.py", "check"],
      "reference": "uchl1",
      "reproduce": ["scripts/expression.py", "reproduce", "--reference", "uchl1"],
      "dependencies": ["uv", "credentials", "alphagenome-variant-impact-score", "alphagenome-single-variant-analysis",
                       "alphagenome-atlas-website-links", "embl-ebi-ols", "ensembl-database", "alphagenome"],
      "keys": {"required": ["ALPHAGENOME_API_KEY"], "optional": []}
    },
    "splicing-analysis": {
      "repo": "cnpem/plp1-splicing-analysis",
      "private": true,
      "check": ["scripts/splicing.py", "check"],
      "reference": "plp1",
      "reproduce": ["scripts/splicing.py", "reproduce", "--reference", "plp1"],
      "dependencies": ["uv", "credentials", "alphagenome-variant-impact-score", "alphagenome-single-variant-analysis",
                       "alphagenome-atlas-website-links", "clinvar-database", "gnomad-database", "dbsnp-database",
                       "ensembl-database", "alphagenome"],
      "keys": {"required": ["ALPHAGENOME_API_KEY"], "optional": ["NCBI_API_KEY"]}
    }
  },
  "dependency_skills": {
    "uv": {"repo": "google-deepmind/science-skills", "purpose": "runs every script of the analysis with fixed package versions"},
    "credentials": {"repo": "google-deepmind/science-skills", "purpose": "keeps the access keys in ~/.env without showing them"},
    "alphagenome-variant-impact-score": {"repo": "google-deepmind/science-skills", "purpose": "gives the gene structure, the list of AlphaGenome tracks and the impact score of each variant"},
    "alphagenome-single-variant-analysis": {"repo": "google-deepmind/science-skills", "purpose": "interprets the top variants with the AlphaGenome model"},
    "alphagenome-atlas-website-links": {"repo": "google-deepmind/science-skills", "purpose": "links each top variant to its AlphaGenome Atlas page"},
    "embl-ebi-ols": {"repo": "google-deepmind/science-skills", "purpose": "finds the ontology terms (UBERON, CL) of the tissues"},
    "ensembl-database": {"repo": "google-deepmind/science-skills", "purpose": "gives the reference DNA sequence and the regulatory regions"},
    "clinvar-database": {"repo": "google-deepmind/science-skills", "purpose": "gives clinical variant records (splicing)"},
    "gnomad-database": {"repo": "google-deepmind/science-skills", "purpose": "gives population frequencies (splicing)"},
    "dbsnp-database": {"repo": "google-deepmind/science-skills", "purpose": "gives variant identifiers (splicing)"},
    "alphagenome": {"repo": "K-Dense-AI/scientific-agent-skills", "purpose": "gives the AlphaGenome Atlas scores per tissue"}
  },
  "agents": {
    "Claude (app or Claude Code)": "claude-code",
    "OpenCode": "opencode",
    "Antigravity": "antigravity",
    "Codex": "codex",
    "Cursor": "cursor",
    "Gemini CLI": "gemini-cli"
  },
  "network": ["https://github.com", "https://registry.npmjs.org", "https://pypi.org", "https://files.pythonhosted.org",
              "https://rest.ensembl.org/info/ping?content-type=application/json", "https://www.ebi.ac.uk/ols4/api/ontologies?size=1"]
}
